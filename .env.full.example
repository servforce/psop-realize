# 完整部署：使用 docker-compose.yml，同时启动 PostgreSQL 和 MinIO。

# 运行环境，如 dev、prod
APP_ENV=prod

# 对外访问地址与服务端口
# MCP 返回资源链接时使用的外部可访问地址
PSOP_REALIZE_VIDEO_PUBLIC_BASE_URL=http://127.0.0.1:8090
# 视频 API 的宿主机端口，映射到容器 8090
PSOP_REALIZE_API_PORT=8090
# MCP 服务的宿主机端口，映射到容器 8100
PSOP_REALIZE_MCP_PORT=8100
# MCP HTTP 服务路径
PSOP_REALIZE_MCP_PATH=/mcp
# MCP 访问令牌；留空不启用鉴权
PSOP_REALIZE_MCP_BEARER_TOKEN=

# 内置 PostgreSQL 服务
# 内置 PostgreSQL 初始化数据库名称
POSTGRES_DB=octopus_video
# 内置 PostgreSQL 初始化用户名
POSTGRES_USER=postgres
# 内置 PostgreSQL 初始化密码，生产环境请修改
POSTGRES_PASSWORD=postgres
# PostgreSQL 的宿主机端口，映射到容器 5432
POSTGRES_PORT=5432

# 内置 MinIO 服务
# 内置 MinIO 管理员账号，同时作为应用访问密钥 ID
MINIO_ROOT_USER=minioadmin
# 内置 MinIO 管理员密码，同时作为应用访问密钥，生产环境请修改
MINIO_ROOT_PASSWORD=minioadmin
# MinIO API 的宿主机端口，映射到容器 9000
MINIO_API_PORT=9000
# MinIO 管理控制台的宿主机端口，映射到容器 9001
MINIO_CONSOLE_PORT=9001
# 视频及处理结果的存储桶名称
OBJECT_STORE_BUCKET=servforce-materials
# 对象存储区域
OBJECT_STORE_REGION=us-east-1

# 外部模型服务
# 模型服务 API 密钥，请勿泄露
MODEL_API_KEY=
# OpenAI 兼容接口的基础地址
MODEL_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 文本模型名称；结构化任务由 TRANSCRIPT_STRUCTURE_MODEL 指定
QWEN_TEXT_MODEL=qwen3.7-plus
# 采样温度，越低输出越稳定
QWEN_TEXT_TEMPERATURE=0.1
# 核采样概率阈值
QWEN_TEXT_TOP_P=0.8
# 输出 token 上限配置；结构化任务最多使用 12000
QWEN_TEXT_MAX_TOKENS=24000
# 文本模型请求超时（秒）
QWEN_TEXT_TIMEOUT_SECONDS=1800
# 结构化输入文本的字符预算
QWEN_TEXT_MAX_INPUT_CHARS=600000
# 转录文本结构化实际使用的模型
TRANSCRIPT_STRUCTURE_MODEL=qwen3.7-plus

# 外部部署的本地语音识别（ASR）服务
# 本地 ASR 服务根地址，不含 /v1/audio/transcriptions
LOCAL_ASR_API_BASE_URL=
# 语音识别语言代码，如 zh
LOCAL_ASR_LANGUAGE=zh
# 语音识别请求超时（秒）
LOCAL_ASR_TIMEOUT_SECONDS=3600
# 请求总尝试次数，含首次请求；至少执行 1 次
LOCAL_ASR_MAX_RETRIES=1
# 审计及结果中记录的 ASR 模型名称，不用于切换模型
LOCAL_ASR_MODEL_LABEL=Qwen/Qwen3-ASR-1.7B

# 模型目录与推理设备；下方模型权重路径须为容器内路径
# 宿主机模型目录，只读挂载到容器 /models
PSOP_REALIZE_MODEL_DIR=./models
# 图索引模型推理设备，如 cuda、cpu
VIDEO_GRAPH_INDEX_DEVICE=cpu
# 微调后的 YOLO-World 检测模型权重路径
VIDEO_GRAPH_INDEX_FINETUNED_YOLO_WORLD_MODEL=/app/runs/yolo_world/robot_arm_parts_v1/weights/best.pt
# SAM 分割模型名称或权重路径
VIDEO_GRAPH_INDEX_MOBILE_SAM_MODEL=/models/sam2.1_b.pt

# 视频处理
# 单个视频上传大小上限（字节）
VIDEO_MAX_UPLOAD_BYTES=2147483648
# 视频分析帧数上限
VIDEO_MAX_ANALYZED_FRAMES=120
# 帧清晰度最低分，低于此值视为模糊
VIDEO_FRAME_SELECTION_MIN_BLUR_SCORE=25
# 暗像素占比阈值（0–1），达到时剔除
VIDEO_FRAME_SELECTION_DARK_RATIO_THRESHOLD=0.9
# 亮像素占比阈值（0–1），达到时剔除
VIDEO_FRAME_SELECTION_BRIGHT_RATIO_THRESHOLD=0.9
# 帧平均亮度下限（0–255）
VIDEO_FRAME_SELECTION_MIN_MEAN_BRIGHTNESS=8
# 帧平均亮度上限（0–255）
VIDEO_FRAME_SELECTION_MAX_MEAN_BRIGHTNESS=248
# 分析用转码视频高度（像素）
VIDEO_ANALYSIS_PROXY_HEIGHT=720
# 分析视频编码 CRF，越大压缩越强、画质越低
VIDEO_ANALYSIS_PROXY_CRF=28
# 分析视频编码速度预设，如 medium
VIDEO_ANALYSIS_PROXY_PRESET=medium
# 分析视频音频码率，如 128k
VIDEO_ANALYSIS_PROXY_AUDIO_BITRATE=128k
# 密集抽帧间隔（秒）
VIDEO_DENSE_FRAME_INTERVAL_SECONDS=2
# 是否启用场景切换抽帧
VIDEO_SCENE_CHANGE_FRAME_ENABLED=true
# 场景切换检测阈值，越低越敏感
VIDEO_SCENE_CHANGE_THRESHOLD=0.25
# 候选帧最小时间间隔（毫秒）
VIDEO_CANDIDATE_FRAME_MIN_SPACING_MS=500
# 相似帧去重的时间窗口（秒）
VIDEO_DEDUP_TIME_WINDOW_SECONDS=10
# HSV 颜色相似度阈值，越高去重条件越严格
VIDEO_DEDUP_HSV_SIMILARITY_THRESHOLD=0.92
# 感知哈希距离阈值，越小去重条件越严格
VIDEO_DEDUP_PHASH_DISTANCE_THRESHOLD=6
# 目标检测置信度阈值
VIDEO_GRAPH_INDEX_YOLO_WORLD_CONFIDENCE=0.10
# 目标检测非极大值抑制的 IoU 阈值
VIDEO_GRAPH_INDEX_YOLO_WORLD_IOU=0.35
# 每帧最多保留的检测目标数
VIDEO_GRAPH_INDEX_YOLO_WORLD_MAX_DET=12
# 后台任务空闲轮询间隔（秒）
WORKER_POLL_INTERVAL_SECONDS=1
